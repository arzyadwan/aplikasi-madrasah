# Koneksi PostgreSQL
DATABASE_URL="postgresql://madrasah:GANTI_PASSWORD@localhost:5432/madrasah"
# Rahasia sesi login: isi string acak minimal 32 karakter (contoh: openssl rand -hex 32)
SESSION_SECRET=""
# Zona waktu madrasah. Konawe (Sulawesi Tenggara) = WITA = Asia/Makassar
APP_TZ="Asia/Makassar"
# Folder penyimpanan foto selfie absen guru
UPLOAD_DIR="./data/uploads"
# Kata sandi awal akun admin saat seed (kosongkan agar dibuat acak)
SEED_ADMIN_PASSWORD=""
